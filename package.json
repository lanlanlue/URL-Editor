{
  "name": "url-editor",
  "version": "2.1.3",
  "description": "This is a small widget for editing URL",
  "author": "Darren Lan (梓恆)",
  "license": "MIT",
  "source": "src/index.html",
  "scripts": {
    "test": "jest --forceExit",
    "test:worker": "jest --forceExit --runInBand src/server",
    "test:coverage": "jest --coverage",
    "start": "parcel",
    "build": "node scripts/build.mjs runtime",
    "build:cloud": "node scripts/build.mjs cloud",
    "build:gh": "node scripts/build.mjs local gh",
    "security:check": "node scripts/security-check.mjs",
    "build:extension": "parcel build src/index.html --dist-dir dist-extension && copyfiles -u 2 src/static/manifest.json dist-extension",
    "prepare": "husky install",
    "lint": "eslint . --ext .js",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@babel/preset-env": "^7.24.8",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^29.7.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel": "^2.14.4",
    "prettier": "^3.3.3"
  }
}
