{
  "manifest_version": 3,
  "name": "URL Editor",
  "version": "2.2.0",
  "description": "Edit, compare, and test URLs from your browser toolbar.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
